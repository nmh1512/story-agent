MYSQL_ROOT_PASSWORD=root
MYSQL_USER=story
MYSQL_PASSWORD=story
MYSQL_DB=story_agent

# LLM Provider: ollama | openai_compatible | gemini | openai
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3:8b
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_API_KEY_GEMINI=
LLM_API_KEY_OPENAI=

LOG_LEVEL=INFO
QUALITY_THRESHOLD=7
DAILY_PLAN_HOUR=2
DAILY_PLAN_MINUTE=0
